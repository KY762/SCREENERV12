# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / frontend
node_modules/
dist/
.vite/

# Data — market data is re-ingestable, never versioned.
# `data/*`, not `data/`: git cannot re-include a file whose parent directory is
# excluded, so `data/` made the negations below dead letters and the one
# reference file in the repo is tracked only because it was force-added. A new
# one would have been skipped silently, which is exactly what those negations
# exist to prevent.
data/*
*.db
*.sqlite3
*.parquet
*.csv

# OS / editor
.DS_Store
.idea/
.vscode/

# Reference datasets the research depends on are versioned with it: the
# point-in-time S&P 500 membership defines the universe, and an upstream
# update must show up as a change here rather than silently restating what
# was tested. Everything else under data/ stays ignored.
!data/reference/
!data/reference/**

# Personal financial data — NEVER commit. This repository is public.
# Brokerage exports, statements and trade history live here and stay here.
private/
*.1099*
robinhood*.csv
