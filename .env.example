# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- Database ---------------------------------------------------------------
# Local Postgres via docker compose (see docker-compose.yml)
DATABASE_URL=postgresql+psycopg://screener:screener@localhost:5432/screener

# --- Alpaca (free tier: market data + paper trading) ------------------------
# alpaca.markets -> Paper Trading -> API Keys -> Generate
# The secret is displayed once. Store it here immediately.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# 'iex' is the free feed. 'sip' requires a paid subscription.
ALPACA_FEED=iex

# --- FRED (free, instant) ---------------------------------------------------
# fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# --- SEC EDGAR (no key; a descriptive User-Agent is required by their policy) -
SEC_USER_AGENT=SCREENERV12 your-email@example.com

# --- Anthropic (not needed until Phase 9) -----------------------------------
# console.anthropic.com -> API Keys. Set a monthly spend limit.
ANTHROPIC_API_KEY=
